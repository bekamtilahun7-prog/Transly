# API only. Lives in server/. Never put these in client/.
# Do not prefix these with VITE_ — that would send them to the browser.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-pro-preview-tts
GEMINI_MOCK=true
PARTNER_API_KEY_DEMO=
PORT=3000
# Sending-only key scoped to mail.transly.com. Never commit the real value.
RESEND_API_KEY=
RESEND_FROM=Transly <hello@mail.transly.com>
